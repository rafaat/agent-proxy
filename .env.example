# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=change-me
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO
# Only for local development. Never expose an unauthenticated gateway.
ALLOW_NO_AUTH=false

# Optional Host/Origin allow lists for MCP DNS-rebinding protection.
# Leave empty when serving through a tunnel (bearer auth still applies).
# Example: ALLOWED_HOSTS=127.0.0.1:*,localhost:*,gateway.example.com
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Sandboxing and limits
# ---------------------------------------------------------------------------
# Comma-separated. The first entry is the default working_dir.
ALLOWED_WORKSPACES=/Users/you/dev/project-a,/Users/you/dev/project-b
SUBPROCESS_TIMEOUT_SECONDS=300
MAX_CONCURRENCY_PER_AGENT=2
MAX_OUTPUT_BYTES=1000000
MAX_PROMPT_CHARS=200000

# ---------------------------------------------------------------------------
# Binaries (absolute paths are recommended when running as a service)
# ---------------------------------------------------------------------------
CLAUDE_BIN=claude
COPILOT_BIN=copilot
OPENCODE_BIN=opencode
CODEX_BIN=codex

# ---------------------------------------------------------------------------
# Command templates (shlex syntax)
# Placeholders: {prompt} {cwd} {model} {session_id}
# If a template has no {prompt}, the prompt is piped to the process stdin.
# <AGENT>_ARGS starts a new session. <AGENT>_RESUME_ARGS replaces it when a caller
# passes session_id. <AGENT>_NEW_SESSION_ARGS is appended for new sessions when the
# CLI accepts a gateway-generated UUID. Otherwise the id is read from JSON output
# (<AGENT>_OUTPUT_FORMAT: text | opencode_json | codex_jsonl).
# Placeholders are substituted after splitting, so the prompt is always a
# single argv element and is never interpreted by a shell.
# ---------------------------------------------------------------------------
# Claude Code: prompt via stdin. acceptEdits lets it edit files in cwd;
# use --permission-mode bypassPermissions only in a throwaway sandbox.
CLAUDE_ARGS=-p --output-format text --permission-mode acceptEdits
CLAUDE_RESUME_ARGS=-p --output-format text --permission-mode acceptEdits --resume {session_id}
CLAUDE_NEW_SESSION_ARGS=--session-id {session_id}
CLAUDE_OUTPUT_FORMAT=text
CLAUDE_MODEL_ARGS=--model {model}
CLAUDE_DEFAULT_MODEL=

# GitHub Copilot CLI: non-interactive mode denies any tool without an allow rule.
# Add rules like "--allow-tool shell(git:*)" or use --allow-all-tools if you accept the risk.
COPILOT_ARGS=--prompt={prompt} --silent --no-color --no-ask-user --allow-tool write
COPILOT_RESUME_ARGS=--prompt={prompt} --silent --no-color --no-ask-user --allow-tool write --resume={session_id}
COPILOT_NEW_SESSION_ARGS=--session-id={session_id}
COPILOT_OUTPUT_FORMAT=text
COPILOT_MODEL_ARGS=--model {model}
COPILOT_DEFAULT_MODEL=

# OpenCode: model format is provider/model (e.g. anthropic/claude-sonnet-4-5)
OPENCODE_ARGS=run --format json {prompt}
OPENCODE_RESUME_ARGS=run --format json --session {session_id} {prompt}
OPENCODE_NEW_SESSION_ARGS=
OPENCODE_OUTPUT_FORMAT=opencode_json
OPENCODE_MODEL_ARGS=-m {model}
OPENCODE_DEFAULT_MODEL=

# OpenAI Codex CLI: "-" reads the prompt from stdin. --json emits events that carry the
# thread id. workspace-write limits edits to cwd. Don't add --ephemeral, it disables resume.
# `codex exec resume` has no --sandbox flag, so the sandbox is set with -c. Run `codex login` first.
CODEX_ARGS=exec --json --skip-git-repo-check --sandbox workspace-write --color never -
CODEX_RESUME_ARGS=exec resume --json --skip-git-repo-check -c sandbox_mode=workspace-write {session_id} -
CODEX_NEW_SESSION_ARGS=
CODEX_OUTPUT_FORMAT=codex_jsonl
CODEX_MODEL_ARGS=-m {model}
CODEX_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# ACP mode (Agent Client Protocol over stdio JSON-RPC)
# Set <AGENT>_MODE=acp to drive the agent through ACP instead of its CLI.
# ---------------------------------------------------------------------------
CLAUDE_MODE=cli
COPILOT_MODE=cli
OPENCODE_MODE=cli
CODEX_MODE=cli
OPENCODE_ACP_ARGS=acp --cwd {cwd}
COPILOT_ACP_ARGS=--acp
# Claude and Codex have no built-in ACP server. To use ACP, point the BIN at an
# adapter (e.g. CODEX_BIN=codex-acp) and set MODE=acp. Empty ARGS is fine for adapters.
CLAUDE_ACP_ARGS=
CODEX_ACP_ARGS=
# Interactive MCP tools use ACP regardless of MODE. Copilot and OpenCode
# reuse their configured BIN; Claude and Codex use separate ACP adapters.
CLAUDE_INTERACTIVE_BIN=claude-agent-acp
CODEX_INTERACTIVE_BIN=codex-acp
# How non-interactive ACP runs answer session/request_permission: allow | reject.
# Requests reporting paths outside ALLOWED_WORKSPACES are rejected.
ACP_PERMISSION_POLICY=allow

# ---------------------------------------------------------------------------
# Session stores (list_sessions, and validating session_id before resuming)
# ---------------------------------------------------------------------------
CLAUDE_PROJECTS_DIR=~/.claude/projects
COPILOT_SESSION_STATE_DIR=~/.copilot/session-state
CODEX_SESSIONS_DIR=~/.codex/sessions
CODEX_SESSION_INDEX=~/.codex/session_index.jsonl
OPENCODE_SESSION_LIST_ARGS=session list --format json -n 1000

# ---------------------------------------------------------------------------
# Discovery (list_available_agents). Empty auth check = "unknown".
# ---------------------------------------------------------------------------
CLAUDE_VERSION_ARGS=--version
COPILOT_VERSION_ARGS=--version
OPENCODE_VERSION_ARGS=--version
CODEX_VERSION_ARGS=--version
CLAUDE_AUTH_CHECK_ARGS=auth status
COPILOT_AUTH_CHECK_ARGS=
OPENCODE_AUTH_CHECK_ARGS=auth list
CODEX_AUTH_CHECK_ARGS=login status

# ---------------------------------------------------------------------------
# Claude `mcp serve` proxy (re-exports native Claude tools as claude_<Tool>)
# ---------------------------------------------------------------------------
CLAUDE_MCP_PROXY_ENABLED=true
CLAUDE_MCP_SERVE_ARGS=mcp serve
CLAUDE_PROXY_TOOL_PREFIX=claude_
# "*" exposes everything. Bash runs arbitrary commands in the first workspace,
# so it is not enabled by default. Path arguments of file tools are sandboxed.
CLAUDE_PROXY_TOOLS=Read,Edit,Write,NotebookEdit,WebFetch,WebSearch
